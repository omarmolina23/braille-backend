{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Bash(cat *.env*)",
      "Bash(git push --force *)"
    ],
    "ask": ["Bash(git push *)", "Bash(pnpm db:migrar *)", "Bash(pnpm add *)"],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(pnpm openapi:exportar)"
    ]
  }
}
